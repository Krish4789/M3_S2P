#include <mpi.h>
#include <stdio.h>
#include <string.h>

int main(int argc, char* argv[]) {
    int rank, size;
    char message[100];

    // Initialize the MPI environment
    MPI_Init(&argc, &argv);

    // Get the rank of the process
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);

    // Get the number of processes
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    if (rank == 0) {
        // Master process sets the message
        strcpy(message, "Hello World from the Master using MPI_Bcast!");
        printf("Master is broadcasting message: %s\n", message);
    }

    // Broadcast the message from master (rank 0) to all other processes
    MPI_Bcast(message, 100, MPI_CHAR, 0, MPI_COMM_WORLD);

    // All processes (including master) now have the message
    printf("Process %d received message: %s\n", rank, message);

    // Finalize the MPI environment
    MPI_Finalize();
    return 0;
}
